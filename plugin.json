      "tabs": [
        {
          "id": "totp",
          "label": "stitch-totp.tab",
          "icon": "Shield",
          "page": "main"
        }
      ],
      "page": {
        "title": "stitch-totp.title",
        "nodes": [
          {
            "kind": "section",
            "title": "stitch-totp.keys",
            "nodes": [
              {
                "kind": "table",
                "id": "totp-keys",
                "columns": [
                  {
                    "key": "label",
                    "label": "stitch-totp.label"
                  },
                  {
                    "key": "issuer",
                    "label": "stitch-totp.issuer"
                  },
                  {
                    "key": "secret",
                    "label": "stitch-totp.secret"
                  },
                  {
                    "key": "enabled",
                    "label": "stitch-totp.enabled"
                  }
                ],
                "source": {
                  "command": "list_keys"
                },
                "rowActions": [
                  {
                    "id": "remove-key-row",
                    "label": "stitch-totp.removeRow",
                    "command": "remove_key",
                    "variant": "danger",
                    "paramsFromRow": {
                      "id": "id"
                    }
                  }
                ]
              }
            ]
          },
          {
            "kind": "section",
            "nodes": [
              {
                "kind": "field",
                "field": "text",
                "id": "label-field",
                "label": "stitch-totp.label",
                "placeholder": "stitch-totp.labelPlaceholder"
              },
              {
                "kind": "field",
                "field": "text",
                "id": "secret-field",
                "label": "stitch-totp.secret",
                "placeholder": "stitch-totp.secretPlaceholder"
              },
              {
                "kind": "button",
                "id": "add-key",
                "label": "stitch-totp.add",
                "command": "add_key",
                "params": {
                  "label": "",
                  "secret": ""
                },
                "paramsFrom": {
                  "label": "label-field",
                  "secret": "secret-field"
                },
                "variant": "primary"
              },
              {
                "kind": "button",
                "id": "remove-key",
                "label": "stitch-totp.remove",
                "command": "remove_key",
                "params": {
                  "id": ""
                },
                "variant": "danger"
              }
            ]
          }
        ]
      }
    },
