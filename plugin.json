      },
      "status": "stable"
    },
    {
      "title": {
        "ru": "Шифрование секретов Fernet в собственной SQLite-базе плагина",
        "en": "Fernet-encrypted secrets in the plugin's own SQLite database"
      },
      "status": "stable"
    },
    {
      "title": {
        "ru": "Вкладка «2FA»: таблица ключей и формы добавления/удаления",
        "en": "2FA tab: key table plus add/remove forms"
      },
      "status": "stable"
    },
    {
      "title": {
        "ru": "Идемпотентный импорт ключей из ядра (import_secrets)",
        "en": "Idempotent key import from core storage (import_secrets)"
      },
      "status": "stable"
    }
  ],
